{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism",
  "version": "0.2.0",
  "identifier": "dev.rabimba.prism",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Prism",
        "width": 1140,
        "height": 760,
        "minWidth": 820,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
