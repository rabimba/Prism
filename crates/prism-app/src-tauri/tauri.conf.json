{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism",
  "version": "0.2.0",
  "identifier": "dev.rabimba.prism",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Prism — Multimodal Search, Semantic ASR & Containment",
        "width": 1140,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
